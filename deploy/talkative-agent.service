# systemd user unit: the agent side (runs the Claude CLI in your project).
# Install: copy to ~/.config/systemd/user/, edit WorkingDirectory, then
#   systemctl --user daemon-reload && systemctl --user enable --now talkative-agent
[Unit]
Description=Talkative agent
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Talkative
ExecStart=%h/.bun/bin/bun src/main.ts agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
